#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

BASE=test-data/localization
BASELINE="$BASE/phase1-before.txt"
DELETED_TEST_IDS="$BASE/deleted-test-ids.txt"
LIST_CMD=(cargo nextest list --workspace --exclude command-signatures-v2 --message-format json)

list_tests() (
  local inventory
  inventory=$(mktemp "${TMPDIR:-/tmp}/term4u-nextest-inventory.XXXXXX")
  trap "rm -f -- $(printf '%q' "$inventory")" EXIT
  "${LIST_CMD[@]}" > "$inventory"
  python3 - "$inventory" <<'PY'
import json
import sys

try:
    with open(sys.argv[1]) as source:
        data = json.load(source)
    suites = data["rust-suites"]
    if not isinstance(suites, dict) or not suites:
        raise ValueError("missing or empty rust-suites")
    tests = []
    for binary_id, suite in suites.items():
        cases = suite["testcases"]
        if not isinstance(cases, dict):
            raise ValueError(f"invalid testcases for {binary_id}")
        for name in cases:
            tests.append(f"{binary_id}::{name}")
    if not tests:
        raise ValueError("nextest returned no tests")
except (OSError, ValueError, KeyError, TypeError) as error:
    sys.exit(f"ERROR: invalid nextest inventory: {error}")
print("\n".join(sorted(tests)))
PY
)

snapshot_tests() (
  local name=$1 snapshot
  mkdir -p "$BASE"
  snapshot=$(mktemp "$BASE/.test-inventory.XXXXXX")
  trap "rm -f -- $(printf '%q' "$snapshot")" EXIT
  list_tests > "$snapshot"
  mv "$snapshot" "$BASE/$name.txt"
  wc -l "$BASE/$name.txt"
)

verify_inventory() {
  test -f "$BASELINE"
  if [[ ! -f "$DELETED_TEST_IDS" ]]; then
    echo "ERROR: missing $DELETED_TEST_IDS" >&2
    return 1
  fi

  local current disappeared unlisted stale
  current=$(mktemp "${TMPDIR:-/tmp}/term4u-current-tests.XXXXXX")
  disappeared=$(mktemp "${TMPDIR:-/tmp}/term4u-disappeared-tests.XXXXXX")
  unlisted=$(mktemp "${TMPDIR:-/tmp}/term4u-unlisted-tests.XXXXXX")
  stale=$(mktemp "${TMPDIR:-/tmp}/term4u-stale-deleted-tests.XXXXXX")
  trap "rm -f '$current' '$disappeared' '$unlisted' '$stale'" EXIT

  list_tests > "$current"
  comm -23 <(sort "$BASELINE") <(sort "$current") > "$disappeared"
  comm -23 <(sort "$disappeared") <(sort "$DELETED_TEST_IDS") > "$unlisted"
  comm -13 <(sort "$disappeared") <(sort "$DELETED_TEST_IDS") > "$stale"

  if [[ -s "$unlisted" ]]; then
    echo "ERROR: tests disappeared outside deleted-test-ids.txt:" >&2
    cat "$unlisted" >&2
    return 1
  fi
  if [[ -s "$stale" ]]; then
    echo "ERROR: deleted-test-ids.txt contains tests that did not disappear:" >&2
    cat "$stale" >&2
    return 1
  fi
  echo "OK: every disappeared test is explicitly listed in deleted-test-ids.txt"
  echo "Baseline tests: $(wc -l < "$BASELINE" | tr -d ' ')"
  echo "Current tests: $(wc -l < "$current" | tr -d ' ')"
  echo "Deleted tests: $(wc -l < "$disappeared" | tr -d ' ')"
}

case "${1:-verify}" in
  verify)
    verify_inventory
    ;;
  list)
    list_tests
    ;;
  snapshot)
    name=${2:?need a snapshot name}
    snapshot_tests "$name"
    ;;
  diff)
    before="$BASE/${2:?need the earlier snapshot name}.txt"
    after="$BASE/${3:?need the later snapshot name}.txt"
    test -f "$before"
    test -f "$after"
    diff -u "$before" "$after" || true
    comm -23 <(sort "$before") <(sort "$after") > /tmp/term4u-disappeared-tests.txt
    if [[ ! -s /tmp/term4u-disappeared-tests.txt ]]; then
      echo "OK: no tests disappeared"
      exit 0
    fi
    whitelist="$DELETED_TEST_IDS"
    if [[ ! -f "$whitelist" ]]; then
      echo "ERROR: tests disappeared, but $whitelist does not exist:" >&2
      cat /tmp/term4u-disappeared-tests.txt >&2
      exit 1
    fi
    if comm -23 <(sort /tmp/term4u-disappeared-tests.txt) <(sort "$whitelist") | grep -q .; then
      echo "ERROR: tests disappeared outside deleted-test-ids.txt:" >&2
      comm -23 <(sort /tmp/term4u-disappeared-tests.txt) <(sort "$whitelist") >&2
      exit 1
    fi
    echo "OK: every disappeared test is explicitly whitelisted"
    ;;
  classify)
    python3 script/lib/classify_tests.py --out "$BASE"
    ;;
  *)
    echo "usage: $0 {verify|list|snapshot NAME|diff BEFORE AFTER|classify}" >&2
    exit 2
    ;;
esac
