#!/usr/bin/env bash
set -eo pipefail

OS_TYPE="$(uname -s)"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
PLATFORM_ARGS=()

cd "${REPO_ROOT}"

usage() {
  cat <<EOF
Usage: ./script/bootstrap [options]

Prepare this checkout for Term4u development by running the platform-specific bootstrap steps.
Bundled and repository-local skills are used as checked in; bootstrap never downloads or updates
agent skills.

Options:
  -h, --help          Show this help message.
  -y, --yes           Skip sudo confirmation prompts.
  --skip-gcloud-auth  Skip the gcloud authentication check.
EOF
}

print_bootstrap_preview() {
  local platform="$1"

  echo "Term4u bootstrap is starting for ${platform}."
  echo "It will install platform development dependencies."
  if [[ "${WARP_SKIP_GCLOUD_AUTH:-0}" = "1" ]]; then
    echo "It will skip gcloud authentication."
  fi
  echo
}

for arg in "$@"; do
  case "${arg}" in
    -h|--help)
      usage
      exit 0
      ;;
    -y|--yes)
      export WARP_SKIP_SUDO_PROMPT=1
      PLATFORM_ARGS+=("${arg}")
      ;;
    --skip-gcloud-auth)
      export WARP_SKIP_GCLOUD_AUTH=1
      ;;
    *)
      echo "error: unknown argument '${arg}'" >&2
      echo "Run ./script/bootstrap --help to see available options." >&2
      exit 1
      ;;
  esac
done

ensure_git_lfs() {
  if ! command -v git-lfs >/dev/null 2>&1; then
    echo "warning: git-lfs is required; install it and re-run bootstrap." >&2
    return 1
  fi
  git lfs install --local >/dev/null
  git lfs pull
}

ensure_git_lfs

if [[ "$OS_TYPE" = "Darwin" ]]; then
  print_bootstrap_preview "macOS"
  ./script/macos/bootstrap "${PLATFORM_ARGS[@]}"
elif [[ "$OS_TYPE" = "Linux" ]]; then
  print_bootstrap_preview "Linux"
  ./script/linux/bootstrap "${PLATFORM_ARGS[@]}"
else
  echo "No bootstrap script defined for the current platform!" >&2
  exit 1
fi
